    {
      "lines": [
        122
      ],
      "source": "#### CNN",
      "kind": "module",
      "module": "CNN"
    },
    {
      "lines": [
        124
      ],
      "source": "##### Advantages",
      "kind": "section",
      "module": "CNN"
    },
    {
      "lines": [
        126
      ],
      "source": "Local Connectivity：Sparse Connections → Lower Computation / Local Feature Extraction",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        127
      ],
      "source": "Weight Sharing：Reuse Filters → Fewer Parameters / Location-Independent Feature Detection",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        128
      ],
      "source": "Translation Equivariance：\\[ f(T_\\Delta X)=T_\\Delta f(X) \\] → Input Shifts, Feature Map Shifts Accordingly",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        129
      ],
      "source": "Translation Invariance：\\[ f(T_\\Delta X)=f(X) \\] → Input Shifts, Classification Remains Unchanged",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        131
      ],
      "source": "##### Forward Propagation",
      "kind": "section",
      "module": "CNN"
    },
    {
      "lines": [
        133
      ],
      "source": "Feature Map：\\[ y_{i,j,o} = b_o+ \\sum_{c=1}^{C_{\\mathrm{in}}} \\sum_{u=0}^{k_h-1} \\sum_{v=0}^{k_w-1} w_{o,c,u,v}\\, x_{is_h-p_h+ud_h,\\;js_w-p_w+vd_w,\\;c} \\]",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        134
      ],
      "source": "Kernel Size：$K_{e} = D(K-1) + 1$，Max Index：$i_{max} + K - 1 \\leq L_{in} + 2p -1$",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        135
      ],
      "source": "Output Size：\\[ L_{\\mathrm{out}} = \\left\\lfloor \\frac{L_{\\mathrm{in}}+2P-K_e}{S} \\right\\rfloor+1 \\]",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        136
      ],
      "source": "Parameters=\\[\\left(K_hK_wC_{in}+1\\right)C_{out} \\], MACs=\\[ H_{\\text{out}}W_{\\text{out}}C_{\\text{out}}K_hK_wC_{\\text{in}} \\]",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        137
      ],
      "source": "Grouped：$C'_\\text{in} = C_\\text{in} / G$, Depthwise：$G = C_\\text{in}$",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        139
      ],
      "source": "##### Backward Propagation",
      "kind": "section",
      "module": "CNN"
    },
    {
      "lines": [
        141
      ],
      "source": "Given $s=1, p=0, d=1, c_{in}=1, c_{out}=1$",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        142
      ],
      "source": "1D：\\(y_i=\\sum_{k=0}^{K-1}w_kx_{i+k}+b \\quad \\delta_i=\\frac{\\partial J}{\\partial y_i}\\)",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        143
      ],
      "source": "\\(\\frac{\\partial J}{\\partial w_k}=\\sum_i\\delta_i x_{i+k} \\quad \\frac{\\partial J}{\\partial b}=\\sum_i\\delta_i \\quad \\frac{\\partial J}{\\partial x_a}=\\sum_i\\delta_iw_{a-i}\\)",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        144
      ],
      "source": "2D：\\(y_{i,j}=\\sum_{u,v}w_{u,v}x_{i+u,j+v}+b \\quad \\delta_{i,j}=\\frac{\\partial J}{\\partial y_{i,j}}\\)",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        145
      ],
      "source": "\\(\\frac{\\partial J}{\\partial w_{u,v}}=\\sum_{i,j}\\delta_{i,j}x_{i+u,j+v} \\quad \\frac{\\partial J}{\\partial b}=\\sum_{i,j}\\delta_{i,j} \\quad \\frac{\\partial J}{\\partial x_{a,b}}=\\sum_{i,j}\\delta_{i,j}w_{a-i,b-j}\\)",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        147
      ],
      "source": "##### Receptive Field",
      "kind": "section",
      "module": "CNN"
    },
    {
      "lines": [
        149
      ],
      "source": "\\[ r_0=1 \\quad j_0=1 \\quad j_l=s_lj_{l-1} \\quad r_l=r_{l-1}+(k_l-1)d_lj_{l-1} \\]",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        150
      ],
      "source": "$r_L=1+\\sum_{l=1}^{L}(k_l-1)d_l\\prod_{m=1}^{l-1}s_m$",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        152
      ],
      "source": "##### Pooling",
      "kind": "section",
      "module": "CNN"
    },
    {
      "lines": [
        154
      ],
      "source": "| Pooling | Formula | Advantages |",
      "kind": "table_header",
      "module": "CNN"
    },
    {
      "lines": [
        155
      ],
      "source": "| --- | --- | --- |",
      "kind": "table_separator",
      "module": "CNN"
    },
    {
      "lines": [
        156
      ],
      "source": "| Max | \\(y_{u,v,c}=\\max_{(i,j)\\in\\Omega_{u,v}}x_{i,j,c}\\) | Salient Features → Improve Robustness |",
      "kind": "table_row",
      "module": "CNN"
    },
    {
      "lines": [
        157
      ],
      "source": "| Average | \\(y_{u,v,c}=\\frac{1}{\\lvert\\Omega_{u,v}\\rvert}\\sum_{(i,j)\\in\\Omega_{u,v}}x_{i,j,c}\\) | Smooth Features → Reduce Noise |",
      "kind": "table_row",
      "module": "CNN"
    },
    {
      "lines": [
        158
      ],
      "source": "| Global Average | \\(y_c=\\frac{1}{HW}\\sum_{i=1}^{H}\\sum_{j=1}^{W}x_{i,j,c}\\) | Aggregate Features → Reduce Parameters |",
      "kind": "table_row",
      "module": "CNN"
    },
    {
      "lines": [
        160
      ],
      "source": "##### BatchNorm / Dropout",
      "kind": "section",
      "module": "CNN"
    },
    {
      "lines": [
        162
      ],
      "source": "\\[ \\mu_c=\\frac1M\\sum_{n,h,w}x_{n,h,w,c} \\]，\\[ v_c=\\frac1M\\sum_{n,h,w}(x_{n,h,w,c}-\\mu_c)^2 \\]",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        163
      ],
      "source": "$y_{n,h,w,c}=\\gamma_c\\frac{x_{n,h,w,c}-\\mu_c}{\\sqrt{v_c+\\epsilon}}+\\beta_c$，$y_{n,h,w,c}=\\frac{m_{n,c}}{1-p}x_{n,h,w,c}$",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        165
      ],
      "source": "##### Mask-Aware Convolutions",
      "kind": "section",
      "module": "CNN"
    },
    {
      "lines": [
        167
      ],
      "source": "Partial：\\(y_{i,j}=\\begin{cases}\\frac{K}{N_{i,j}}\\operatorname{Conv}_{w}(x\\odot m)_{i,j}+b & N_{i,j}>0\\\\ 0 & N_{i,j}=0\\end{cases}\\) → Valid Inputs Only",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        168
      ],
      "source": "Submanifold Sparse：\\(y_{i,j}=\\begin{cases}\\operatorname{Conv}_{w}(x\\odot m)_{i,j}+b & m_{i,j}=1\\\\ 0 & m_{i,j}=0\\end{cases}\\) → Active Inputs Only",
      "kind": "body",
      "module": "CNN"
    },
    {
      "lines": [
        169
      ],
      "source": "##### Modern Convolutions",
      "kind": "section",
      "module": "CNN"
    },
    {
      "lines": [
        171
      ],
      "source": "| Model | Key Idea | Advantages |",
      "kind": "table_header",
      "module": "CNN"
    },
    {
      "lines": [
        172
      ],
      "source": "| --- | --- | --- |",
      "kind": "table_separator",
      "module": "CNN"
    },
    {
      "lines": [
        173
      ],
      "source": "| VGG | Stacked Small Convolutional Kernels | Expand Receptive Field Using Less Parameters |",
      "kind": "table_row",
      "module": "CNN"
    },
    {
      "lines": [
        174
      ],
      "source": "| NiN | Pointwise Convolution for Channel Mixing | Fuse Features Across Channels Instead of Fully Connected Layers |",
      "kind": "table_row",
      "module": "CNN"
    },
    {
      "lines": [
        175
      ],
      "source": "| GoogLeNet | Multi-Scale Convolutions | Concatenate Feature Map to Capture Multi-Scale Features |",
      "kind": "table_row",
      "module": "CNN"
    },
    {
      "lines": [
        176
      ],
      "source": "| ResNet | Residual Skip Connections | Improve Gradient Flow & Enable Deeper Networks |",
      "kind": "table_row",
      "module": "CNN"
    },
    {
      "lines": [
        177
      ],
      "source": "| DenseNet | Dense Connections | Enhance Feature Reuse and Improve Gradient Flow |",
      "kind": "table_row",
      "module": "CNN"
    },
    {
      "lines": [
        178
      ],
      "source": "| ResNeXt | Grouped Convolutions | Improve Representation with Efficient Computation |",
      "kind": "table_row",
      "module": "CNN"
    },
    {
      "lines": [
        179
      ],
      "source": "| MobileNet | Depthwise Separable Convolutions | Reduce Parameters and Reduce Computation |",
      "kind": "table_row",
      "module": "CNN"
    },
    {
      "lines": [
        180
      ],
      "source": "| EfficientNet | Compound Scaling | Improve Accuracy–Efficiency Trade-off |",
      "kind": "table_row",
      "module": "CNN"
    },
    {
      "lines": [
        182
      ],
      "source": "#### RNN",
      "kind": "module",
      "module": "RNN"
    },
    {
      "lines": [
        184
      ],
      "source": "##### Sequence Probability Factorization",
      "kind": "section",
      "module": "RNN"
    },
    {
      "lines": [
        186
      ],
      "source": "Probability Chain Rule：$P(x_{1:T})=P(x_1)\\prod_{t=2}^{T}P(x_t\\mid x_{1:t-1})$",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        187
      ],
      "source": "First-Order Markov Assumption：\\[ P(x_{1:T})=P(x_1)\\prod_{t=2}^{T}P(x_t\\mid x_{t-1}) \\]",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        188
      ],
      "source": "Second-Order Markov Assumption：\\[ P(x_{1:T})=P(x_1,x_2)\\prod_{t=3}^{T}P(x_t\\mid x_{t-2},x_{t-1}) \\]",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        189
      ],
      "source": "Hidden Markov Model：$P(x_{1:T},h_{1:T}\\mid\\theta)=P(h_1)\\prod_{t=2}^{T}P(h_t\\mid h_{t-1})\\prod_{t=1}^{T}P(x_t\\mid h_t)$",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        190
      ],
      "source": "Transition Distribution：\\[ P(h_t\\mid h_{1:t-1})=P(h_t\\mid h_{t-1}) \\]",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        191
      ],
      "source": "Emission Distribution：\\[ P(x_t\\mid h_{1:t},x_{1:t-1})=P(x_t\\mid h_t) \\]",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        193
      ],
      "source": "##### Vanilla Recurrent Neural Network",
      "kind": "section",
      "module": "RNN"
    },
    {
      "lines": [
        195
      ],
      "source": "Forward Recurrence：$a_t=W_xx_t+W_hh_{t-1}+b_h$，\\[ h_t=\\tanh(a_t) \\]，\\[ z_t=W_zh_t+b_z \\]，\\[ p_t=\\operatorname{softmax}(z_t) \\]",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        196
      ],
      "source": "Parameter Count：$H(I+H+1)+O(H+1)$",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        197
      ],
      "source": "All RNN parameter counts assume one unidirectional layer, one combined bias per gate, and the output layer; $I,H,O$ are input, hidden and output dimensions.",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        199
      ],
      "source": "##### Backward Propagation Through Time",
      "kind": "section",
      "module": "RNN"
    },
    {
      "lines": [
        201
      ],
      "source": "\\[ \\ell_t=-\\sum_{c=1}^{C}y_{t,c}\\log p_{t,c} \\]，$L=\\sum_{t=1}^{T}\\ell_t$",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        203
      ],
      "source": "\\[ \\delta_t=\\frac{\\partial L}{\\partial a_t}=\\left(\\frac{\\partial h_t}{\\partial a_t}\\right)^\\top\\frac{\\partial L}{\\partial h_t} \\]",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        204
      ],
      "source": "\\[ \\frac{\\partial L}{\\partial h_t}=\\left(\\frac{\\partial z_t}{\\partial h_t}\\right)^\\top\\frac{\\partial L}{\\partial z_t}+\\left(\\frac{\\partial a_{t+1}}{\\partial h_t}\\right)^\\top\\frac{\\partial L}{\\partial a_{t+1}} \\]",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        205
      ],
      "source": "\\[ \\delta_t=\\left(W_z^\\top(p_t-y_t)+W_h^\\top\\delta_{t+1}\\right)\\odot(1-h_t^2),\\quad\\delta_{T+1}=0 \\]",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        207
      ],
      "source": "\\[ \\nabla_{W_z}L=\\sum_{t=1}^{T}(p_t-y_t)h_t^\\top\\]，\\[ \\nabla_{W_x}L=\\sum_{t=1}^{T}\\delta_tx_t^\\top \\]，$\\nabla_{W_h}L=\\sum_{t=1}^{T}\\delta_th_{t-1}^\\top$",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        209
      ],
      "source": "\\[\\nabla_{b_z}L=\\sum_{t=1}^{T}(p_t-y_t) \\]，$\\nabla_{b_h}L=\\sum_{t=1}^{T}\\delta_t$",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        211
      ],
      "source": "$J_t=\\frac{\\partial h_t}{\\partial h_{t-1}} \\to \\frac{\\partial h_T}{\\partial h_t}=J_TJ_{T-1}\\cdots J_{t+1}$：Repeated Jacobian Multiplication → Vanishing / Exploding Gradients",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        213
      ],
      "source": "##### Long Short-Term Memory",
      "kind": "section",
      "module": "RNN"
    },
    {
      "lines": [
        215
      ],
      "source": "Forget Gate：\\[ f_t=\\sigma(W_f[x_t;h_{t-1}]+b_f) \\] → control how much Old Memory to Retain",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        216
      ],
      "source": "Input Gate：\\[ i_t=\\sigma(W_i[x_t;h_{t-1}]+b_i) \\] → control how much New Information to Write",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        217
      ],
      "source": "Output Gate：\\[ o_t=\\sigma(W_o[x_t;h_{t-1}]+b_o) \\] → control how much New Memory to Expose",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        218
      ],
      "source": "Candidate Cell State：\\[ \\tilde c_t=\\tanh(W_c[x_t;h_{t-1}]+b_c) \\] → compute the New Information",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        219
      ],
      "source": "Cell State Update：\\[ c_t=f_t\\odot c_{t-1}+i_t\\odot\\tilde c_t \\] → compute the New Memory",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        220
      ],
      "source": "Hidden State：\\[ h_t=o_t\\odot\\tanh(c_t) \\] → produce the Representation",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        221
      ],
      "source": "$\\left.\\frac{\\partial c_t}{\\partial c_{t-1}}\\right|_{\\mathrm{direct}}=\\operatorname{diag}(f_t) \\to \\left.\\frac{\\partial c_T}{\\partial c_t}\\right|_{\\mathrm{direct}}=\\prod_{k=t+1}^{T}\\operatorname{diag}(f_k)$：Separate Memory + Additive Update → Better Gradients Flow",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        222
      ],
      "source": "Parameter Count：$4H(I+H+1) + O(H + 1)$",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        224
      ],
      "source": "##### GRU",
      "kind": "section",
      "module": "RNN"
    },
    {
      "lines": [
        226
      ],
      "source": "Reset Gate：\\(r_t=\\sigma(W_r[x_t;h_{t-1}]+b_r)\\) → control how much History to Reuse",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        227
      ],
      "source": "Update Gate：\\(z_t=\\sigma(W_z[x_t;h_{t-1}]+b_z)\\) → control how much Old Memory to Retain",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        228
      ],
      "source": "Candidate Hidden State：\\(\\tilde h_t=\\tanh(W_xx_t+r_t\\odot(W_hh_{t-1})+b_h)\\) → compute the New Candidate",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        229
      ],
      "source": "Hidden State Update：\\[ h_t=z_t\\odot h_{t-1}+(1-z_t)\\odot\\tilde h_t \\] → produce the Representation",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        230
      ],
      "source": "\\(\\left.\\frac{\\partial h_t}{\\partial h_{t-1}}\\right|_{\\mathrm{direct}}=\\operatorname{diag}(z_t)\\to\\left.\\frac{\\partial h_T}{\\partial h_t}\\right|_{\\mathrm{direct}}=\\prod_{k=t+1}^{T}\\operatorname{diag}(z_k)\\)：Unified Memory + Additive Update → Better Gradient Flow",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        231
      ],
      "source": "Parameter Count：$3H(I+H+1) + O(H + 1)$",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        233
      ],
      "source": "##### Autoregressive Generation",
      "kind": "section",
      "module": "RNN"
    },
    {
      "lines": [
        235
      ],
      "source": "$P(x_{1:T})=\\prod_{t=1}^{T}P(x_t\\mid x_{<t}) \\approx \\prod_{t=1}^{T}P_\\theta(x_t\\mid h_{t-1})=\\prod_{t=1}^{T}p_{t-1}[x_t]$",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        237
      ],
      "source": "\\[ L=-\\log P(x_{1:T})=-\\sum_{t=1}^{T}\\log P(x_t\\mid x_{<t})\\approx-\\sum_{t=1}^{T}\\log P_\\theta(x_t\\mid h_{t-1})=-\\sum_{t=1}^{T}\\log p_{t-1}[x_t] \\]",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        239
      ],
      "source": "##### Seq2Seq",
      "kind": "section",
      "module": "RNN"
    },
    {
      "lines": [
        241
      ],
      "source": "Encoder：\\[ v=\\operatorname{RNN}(x_1,\\ldots,x_T)=h_T^{\\mathrm{enc}} \\]",
      "kind": "body",
      "module": "RNN"
    },
    {
      "lines": [
        242
      ],
      "source": "Decoder：\\[ h_0^{\\mathrm{dec}}=v=h_T^{\\mathrm{enc}}\\]，\\[ P_\\theta(y_{1:T'}\\mid x_{1:T})=\\prod_{t=1}^{T'}P_\\theta(y_t\\mid v,y_{<t})=\\prod_{t=1}^{T'}P_\\theta(y_t\\mid h_t^{\\mathrm{dec}})=\\prod_{t=1}^{T'}p_t[y_t] \\]",
      "kind": "body",
      "module": "RNN"
    }
  ]
}
