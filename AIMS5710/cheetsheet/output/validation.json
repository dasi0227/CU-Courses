      "source": "##### Fully Connected Layer",
      "kind": "section",
      "module": "NN"
    },
    {
      "lines": [
        5
      ],
      "source": "Forward Propagation：\\[ z=Wx+b \\] → \\[ z_i=\\sum_jW_{ij}x_j+b_i \\]",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        6
      ],
      "source": "Local Derivative：\\[ g_i=\\frac{\\partial L}{\\partial z_i} \\] → \\[ \\frac{\\partial L}{\\partial W_{ij}}=g_ix_j \\quad \\frac{\\partial L}{\\partial x_j}=\\sum_i g_iW_{ij} \\]",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        8
      ],
      "source": "##### Softmax + Cross-Entropy",
      "kind": "section",
      "module": "NN"
    },
    {
      "lines": [
        10,
        11,
        12
      ],
      "source": "$p_i=\\frac{e^{z_i}}{\\sum_{k=1}^{C}e^{z_k}},\\quad L=-\\sum_{k=1}^{C}t_k\\log p_k=-\\log p_c,\\quad \\frac{\\partial L}{\\partial z_i}=p_i-t_i$",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        14
      ],
      "source": "##### Sigmoid + Binary Cross-Entropy",
      "kind": "section",
      "module": "NN"
    },
    {
      "lines": [
        16,
        17,
        18
      ],
      "source": "$p=\\frac{1}{1+e^{-z}},\\quad L=-[t\\log p+(1-t)\\log(1-p)],\\quad \\frac{\\partial L}{\\partial z}=p-t$",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        20
      ],
