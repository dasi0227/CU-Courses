      ],
      "source": "MLP：\\[ z^{(l)}=W^{(l)}h^{(l-1)}+b^{(l)},\\quad h^{(l)}=\\phi_l(z^{(l)})\\]",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        32
      ],
      "source": "Activation → Introduce Nonlinearity；Linear Function → Classification Logits",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        33
      ],
      "source": "Multi-Layer → Improve Representation Efficiency；Perceptron → Final Linear Classification",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        35
      ],
      "source": "##### Regression Losses",
      "kind": "section",
      "module": "NN"
    },
    {
      "lines": [
        37
      ],
      "source": "\\[ L_1=\\frac{1}{N}\\sum_{i=1}^{N}|y_i-\\hat y_i| \\] → \\[ \\frac{\\partial L_1}{\\partial \\hat y_i} =\\frac{1}{N}\\operatorname{sign}(\\hat y_i-y_i) \\] → robust to outliers",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        38
      ],
      "source": "\\[ L_2=\\frac{1}{N}\\sum_{i=1}^{N}(y_i-\\hat y_i)^2 \\] → \\[ \\frac{\\partial L_2}{\\partial \\hat y_i} =\\frac{2}{N}(\\hat y_i-y_i) \\] → sensitive to outliers",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        40
      ],
      "source": "##### Batch Normalization",
      "kind": "section",
      "module": "NN"
    },
    {
      "lines": [
        42
      ],
      "source": "Mean：\\[ \\mu_j=\\frac1N\\sum_i x_{ij} \\], Variance：\\[ v_j=\\frac1N\\sum_i(x_{ij}-\\mu_j)^2 \\]",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        43
      ],
      "source": "Standardization：\\[ \\bar x_{ij}=\\frac{x_{ij}-\\mu_j}{\\sqrt{v_j+\\epsilon}} \\]；Affine Transform：$y_{ij}=\\gamma_j\\bar x_{ij}+\\beta_j$",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        44
      ],
      "source": "Normalize Intermediate Features → Stabilize Gradient Scales → Larger Learning Rates",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        46
      ],
      "source": "##### Dropout",
      "kind": "section",
      "module": "NN"
    },
    {
      "lines": [
        48
      ],
      "source": "Ordinary Dropout：\\[ y_i^{\\mathrm{train}}=m_iz_i, \\quad y_i^{\\mathrm{test}}=qz_i \\]",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        49
      ],
      "source": "Keep Probability $q$；Random Mask \\[ m_i\\sim\\operatorname{Bernoulli}(q) \\]",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        50
      ],
      "source": "Deactivate Neurons → Reduce Co-Adaptation → Mitigate Overfitting / Better Generalization",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        52
      ],
      "source": "##### AutoEncoder",
      "kind": "section",
      "module": "NN"
    },
    {
      "lines": [
        54
      ],
      "source": "Reconstruction Loss：\\[ h=f_\\theta(x),\\quad \\tilde x=g_\\phi(h), \\quad J=\\frac1{2N}\\sum_{i=1}^{N}\\left\\|x^{(i)}-\\tilde x^{(i)}\\right\\|_2^2 \\]",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        55
      ],
      "source": "Low-Dimensional Bottleneck → Learn Latent Representation",
      "kind": "body",
      "module": "NN"
    },
    {
      "lines": [
        57
      ],
      "source": "#### Optimization",
      "kind": "module",
      "module": "Optimization"
    },
    {
      "lines": [
        59
      ],
      "source": "##### Mini-Batch SGD",
      "kind": "section",
      "module": "Optimization"
    },
    {
      "lines": [
        61
      ],
      "source": "Loss Function：$J_{\\mathcal{B}_t}(\\theta) = \\frac{1}{|\\mathcal{B}_t|}\\sum_{i\\in\\mathcal{B}_t} \\ell_i(\\theta)$",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        62
      ],
      "source": "Mini-batch Gradient：\\[ g_t=\\frac{1}{B_t}\\sum_{i\\in\\mathcal B_t}\\nabla\\ell_i(\\theta_t),\\quad B_t=|\\mathcal B_t| \\]",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        63
      ],
      "source": "Gradient Descent：\\[ \\theta_{t+1}=\\theta_t-\\eta_tg_t,\\quad g_t=\\nabla J_{\\mathcal B_t}(\\theta_t) \\]",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        64
      ],
      "source": "Taylor Expansion：$J_{\\mathcal{B}_t}(\\theta_t - \\eta_t g_t) \\approx J_{\\mathcal{B}_t}(\\theta_t) - \\eta_t\\, g_t^\\top g_t = J_{\\mathcal{B}_t}(\\theta_t) - \\eta_t\\|g_t\\|_2^2$",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        65
      ],
      "source": "Smaller $B_t$ → High Gradient Variance → Noisy Updates → Improve Generalization",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        66
      ],
      "source": "Larger $B_t$ → High Memory Usage → Fewer Updates per Epoch → Better Stability",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        67
      ],
      "source": "Smaller $\\eta_t$ → Slow Convergence → More Epochs",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        68
      ],
      "source": "Larger $\\eta_t$ → Repeated Overshooting → Oscillation / Divergence",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        70
      ],
      "source": "##### Momentum",
      "kind": "section",
      "module": "Optimization"
    },
    {
      "lines": [
        72
      ],
      "source": "Exponential Moving Average：$v_t=\\mu v_{t-1}+(1-\\mu)g_t\\ \\quad \\theta_{t+1}=\\theta_t-\\eta_tv_t$",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        73
      ],
      "source": "Accumulate Past Gradients → Reinforce Consistent / Reduce Oscillation → Convergence",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        75
      ],
      "source": "##### L2 Regularization",
      "kind": "section",
      "module": "Optimization"
    },
    {
      "lines": [
        77
      ],
      "source": "Regularization Term：\\[ J_{\\mathrm{reg}}(\\theta) =J_{\\mathrm{data}}(\\theta)+\\frac{\\lambda}{2}\\|\\theta\\|_2^2 \\quad \\nabla_\\theta\\frac{\\lambda}{2}\\|\\theta\\|_2^2=\\lambda\\theta\\]",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        78
      ],
      "source": "Shrinkage Factor：\\[\\theta_{t+1}=\\theta_t-\\eta(g_t+\\lambda\\theta_t)=(1-\\eta\\lambda)\\theta_t-\\eta g_t\\]",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        79
      ],
      "source": "Weight Decay → Penalize Large Weights → Reduce Overfitting → Improve Generalization",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        81
      ],
      "source": "##### Resilient Propagation",
      "kind": "section",
      "module": "Optimization"
    },
    {
      "lines": [
        83
      ],
      "source": "Rprop：\\[ \\begin{aligned} \\eta_{t,i} &= \\begin{cases} \\min(\\alpha\\eta_{t-1,i},\\eta_{\\max}), &g_{t,i}g_{t-1,i}>0,\\,\\alpha>1\\\\ \\max(\\beta\\eta_{t-1,i},\\eta_{\\min}), &g_{t,i}g_{t-1,i}<0,\\,0<\\beta<1\\\\ \\eta_{t-1,i}, &g_{t,i}g_{t-1,i}=0\\end{cases} \\\\ \\theta_{t+1,i} &= \\theta_{t,i}-\\eta_{t,i}\\operatorname{sign}(g_{t,i}) \\end{aligned} \\]",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        84
      ],
      "source": "Consistent Signs → Increase Step Size → Faster Convergence",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        85
      ],
      "source": "Opposite Signs → Decrease Step Size → Reduce Oscillation",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        87
      ],
      "source": "##### Adaptive Learning Rate",
      "kind": "section",
      "module": "Optimization"
    },
    {
      "lines": [
        89
      ],
      "source": "AdaGrad：\\[ s_{t,i}=s_{t-1,i}+g_{t,i}^2 \\quad \\theta_{t+1,i}=\\theta_{t,i}-\\frac{\\eta}{\\sqrt{s_{t,i}}+\\epsilon}g_{t,i}\\]",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        90
      ],
      "source": "RMSProp：\\[ s_{t,i}=\\rho s_{t-1,i}+(1-\\rho)g_{t,i}^2 \\quad \\theta_{t+1,i}=\\theta_{t,i}-\\frac{\\eta}{\\sqrt{s_{t,i}}+\\epsilon}g_{t,i}\\]",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        91
      ],
      "source": "Measure Gradient Magnitudes → Adapt Learning Rates → Reduce Oscillation",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        93
      ],
      "source": "##### Adaptive Moment Estimation",
      "kind": "section",
      "module": "Optimization"
    },
    {
      "lines": [
        95
      ],
      "source": "First-Moment Estimate：\\[ m_t=\\beta_1m_{t-1}+(1-\\beta_1)g_t \\] → Determine Update Direction",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        96
      ],
      "source": "Second Raw-Moment Estimate：\\[ v_t=\\beta_2v_{t-1}+(1-\\beta_2)g_t^2 \\] → Adjust Update Step Size",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        97
      ],
      "source": "Bias Correction：\\[ \\hat m_t=m_t/(1-\\beta_1^t) \\quad \\hat v_t=v_t/(1-\\beta_2^t)\\] → Correct Zero Initialization",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        98
      ],
      "source": "Adam：$\\theta_{t+1}=\\theta_t-\\eta\\frac{\\hat m_t}{\\sqrt{\\hat v_t}+\\epsilon}$ → Adaptive Moment Estimation",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        99
      ],
      "source": "AdamW：$\\theta_{t+1}=(1-\\eta\\lambda)\\theta_t-\\eta\\frac{\\hat m_t}{\\sqrt{\\hat v_t}+\\epsilon}$ → Decoupled Weight Decay",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        101
      ],
      "source": "##### Gradients Problems",
      "kind": "section",
      "module": "Optimization"
    },
    {
      "lines": [
        103
      ],
      "source": "Vanishing / Exploding Gradients → Repeated Multiplication of Local Derivatives",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        104
      ],
      "source": "Gradient Clipping：$g_{\\text{clip}}=g\\cdot\\min\\left(1,\\frac{c}{\\|g\\|_2}\\right)$ → Bounded Gradient Norm",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        106
      ],
      "source": "##### Weight Initialization",
      "kind": "section",
      "module": "Optimization"
    },
    {
      "lines": [
        108
      ],
      "source": "Xavier / Glorot：$W\\sim\\mathcal N\\left(0,\\frac{2}{n_{\\text{in}}+n_{\\text{out}}}\\right) \\quad W\\sim U\\left(-\\sqrt{\\frac{6}{n_{\\text{in}}+n_{\\text{out}}}},\\sqrt{\\frac{6}{n_{\\text{in}}+n_{\\text{out}}}}\\right)$ → sigmoid、tanh",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        109
      ],
      "source": "Kaiming / He：$W\\sim\\mathcal N\\left(0,\\frac{2}{n_{\\text{in}}}\\right) \\quad W\\sim U\\left(-\\sqrt{\\frac{6}{n_{\\text{in}}}},\\sqrt{\\frac{6}{n_{\\text{in}}}}\\right)$ → relu",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        110
      ],
      "source": "Break Neuron Symmetry + Stabilize Signal Scale → Reduce Vanishing / Exploding",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        112
      ],
      "source": "##### Data Augmentation",
      "kind": "section",
      "module": "Optimization"
    },
    {
      "lines": [
        114
      ],
      "source": "Rotation、Flipping、Cropping、Scaling、Jittering、Noise、Erasing",
      "kind": "body",
      "module": "Optimization"
    },
    {
      "lines": [
        116
      ],
      "source": "##### Learning Rate Schedules",
      "kind": "section",
      "module": "Optimization"
    },
    {
      "lines": [
        118
      ],
      "source": "Inverse-Time：\\[\\eta_t=\\frac{\\eta_0}{1+dt}\\]、Step：\\[ \\eta_t=\\eta_0\\gamma^{\\lfloor t/K\\rfloor} \\]、Exponential：\\[ \\eta_t=\\eta_0e^{-kt} \\]",
