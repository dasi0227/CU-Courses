# Formula: Alibaba Cloud Model Studio, Beijing (cn-beijing).
# DEEPSEEK_API_KEY is only the local variable name: its value must be a
# Beijing Model Studio key, not a key for the official DeepSeek API.
# All three roles use siliconflow/deepseek-v3.1-terminus via
# https://dashscope.aliyuncs.com/compatible-mode/v1 with enable_thinking=false.
DEEPSEEK_API_KEY=

# D only: Jev relevance selection when reading the learned playbook.
# https://docs.typesafe.ai
TYPESAFE_API_KEY=
