{
  "seed": 42,
  "repeats": 3,
  "output_dir": "results",
  "llm": {
    "api_provider": "dashscope",
    "model": "siliconflow/deepseek-v3.1-terminus",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "max_tokens": 4096,
    "temperature": 0,
    "timeout": 60,
    "retries": 2,
    "sleep_seconds": 1,
    "api_key_env": "DEEPSEEK_API_KEY",
    "enable_thinking": false,
    "region": "cn-beijing"
  },
  "training": {
    "num_epochs": 1,
    "eval_steps": 20,
    "save_steps": 20,
    "curator_frequency": 1,
    "batch_size": 1,
    "max_num_rounds": 3
  },
  "data": {
    "train_path": "eval/data/formula_train_subset_500.jsonl",
    "val_path": "eval/data/formula_val_subset_300.jsonl",
    "test_path": "eval/data/formula_test.jsonl",
    "sampling": {
      "mode": "per_formula",
      "train_per_formula": 2,
      "val_per_formula": 1
    }
  },
  "jev": {
    "base_url": "https://api.typesafe.ai/v1/systemone",
    "model": "jev-1.13.0",
    "api_key_env": "TYPESAFE_API_KEY",
    "k": 10,
    "batch_size": 20,
    "timeout": 30
  }
}
